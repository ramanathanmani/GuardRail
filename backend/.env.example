# Copy to backend/.env and fill in. Never commit backend/.env.

APP_ENV=dev

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_SMART=claude-sonnet-5

# --- Sarvam (speech-to-text; fallback text-to-speech) ---
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3-realtime
SARVAM_STT_MODE=translit
# auto = Sarvam adaptive language detection; profile = lock to the caller profile's language
SARVAM_STT_LANGUAGE=auto
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=

# --- Voice (text-to-speech): elevenlabs | sarvam ---
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
REPLY_LANGUAGE=en-IN

# --- Payments (refunds): dodo | simulated ---
PAYMENTS=dodo
DODO_PAYMENTS_API_KEY=
DODO_ENVIRONMENT=test_mode

# --- Vobiz (phone line) ---
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_PHONE_NUMBER=
# long random string, e.g. output of: python -c "import secrets; print(secrets.token_urlsafe(24))"
VOBIZ_STREAM_SECRET=
# https://<EC2 hostname> on AWS, or your ngrok URL during development
PUBLIC_BASE_URL=

# --- AWS (credentials come from the EC2 IAM role or your AWS profile, NOT this file) ---
# AUDIT_ARCHIVE: s3 | local (writes backend/audit/)
AWS_REGION=ap-south-1
AUDIT_ARCHIVE=s3
S3_AUDIT_BUCKET=

# --- LLM provider: anthropic | bedrock ---
LLM_PROVIDER=anthropic
BEDROCK_MODEL_FAST=
BEDROCK_MODEL_SMART=

# --- Helpdesk: freshdesk | none (local LOCAL-n ids, offline dev only) | freshservice ---
HELPDESK=freshdesk
# subdomain only: for https://acme.freshdesk.com put acme
FRESHDESK_DOMAIN=
FRESHDESK_API_KEY=
FRESHDESK_CUSTOM_FIELDS=false
FRESHSERVICE_DOMAIN=
FRESHSERVICE_API_KEY=

# --- GuardRail ---
GUARDRAIL_API_KEY=
UNDO_WINDOW_SECONDS=30
SILENCE_TIMEOUT_SECONDS=8
MAX_CALL_SECONDS=180
DEMO_FAULT_INJECTION=off

# --- App ---
DATABASE_URL=sqlite:///./guardrail.db
FRONTEND_ORIGIN=http://localhost:5173
